---
import Layout from "@/layouts/Layout.astro";
import { profile } from "@/settings";
import BetterIcon from "@/components/ui/BetterIcon.astro";
import List from "@/components/ui/List.astro";
import {RESEARCH_ICONS} from "@/data/researchIcons";

const { research_areas } = profile;
---

<Layout title="Research | Dr. Marie Curie">
  <div class="prose max-w-none">
    <h1 class="text-3xl font-bold mb-8">Research Statement</h1>

    <div class="mb-12">
      <p class="text-lg mb-6">
        Marie Curie’s research combined precise physical measurements with chemical analysis. She studied the rays emitted by uranium and thorium compounds, then investigated highly active residues from pitchblende.
      </p>
      <p class="text-lg mb-6">
        In 1898, Marie and Pierre Curie announced polonium and, with Gustave Bémont, radium. Curie’s later work included isolating radium and studying its properties.
      </p>
    </div>

    <h2 class="text-2xl font-bold mb-6">Research Areas</h2>
    <div class="grid gap-8 mb-12">
      {
        research_areas.map((area) => (
          <div class="flex gap-6 items-start">
            <BetterIcon>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="2"
                class="size-6 stroke-accent"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d={RESEARCH_ICONS[area.field as keyof typeof RESEARCH_ICONS]?.path || RESEARCH_ICONS['computer-science'].path}
                />
              </svg>
            </BetterIcon>
            <div>
              <h3 class="text-xl font-semibold mb-2">{area.title}</h3>
              <p class="text-base">{area.description}</p>
            </div>
          </div>
        ))
      }
    </div>

      <List listTitle="Research themes" listItems={[
      {
        title: "Radioactive emissions",
        description: "Comparative measurements of radiation from uranium, thorium, and minerals such as pitchblende."
      },
      {
        title: "Polonium and radium",
        description: "Chemical investigation of unusually active substances and the isolation and characterization of radium."
      }
    ]} />

    <h2 class="text-2xl font-bold mb-6">Research Impact</h2>
    <p class="text-lg mb-6">
      Curie’s work helped establish radioactivity as a field of research and earned her Nobel Prizes in Physics (1903) and Chemistry (1911). Her research also contributed to later scientific and medical uses of radioactive materials.
    </p>
  </div>
</Layout>
